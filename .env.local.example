# Email Configuration
# Gmail SMTP Configuration (sends TO info@indusrivergroup.com group)

# Personal Gmail account to send FROM (Recommended approach for Google Groups)
GMAIL_USER=your-personal-gmail@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password

# Alternative: SendGrid
SENDGRID_API_KEY=your-sendgrid-api-key

# Alternative: Resend
RESEND_API_KEY=your-resend-api-key

# Google Forms Integration
GOOGLE_FORM_URL=https://docs.google.com/forms/d/e/YOUR_FORM_ID/viewform