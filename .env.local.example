# Email Configuration for Google Workspace
# Google Workspace account with credentials sends TO group email which distributes to all members

# Google Workspace account with 2FA and app password (sends FROM this account)
ADMIN_EMAIL_USER=gaurav@indusrivergroup.com
ADMIN_EMAIL_PASSWORD=your-16-character-app-password

# Group email (submissions are sent TO this address)
# This will automatically distribute to all group members
GROUP_EMAIL=info@indusrivergroup.com

# Alternative: SendGrid
SENDGRID_API_KEY=your-sendgrid-api-key

# Alternative: Resend
RESEND_API_KEY=your-resend-api-key

# Google Forms Integration
GOOGLE_FORM_URL=https://docs.google.com/forms/d/e/YOUR_FORM_ID/viewform